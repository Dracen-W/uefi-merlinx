+  SelectGraphicsConsole ();
 
   BootOption = EfiBootManagerGetLoadOptions (&BootOptionCount, LoadOptionTypeBoot);
+  DEBUG ((DEBUG_ERROR, "BootManagerMenu: options=%u\n", BootOptionCount));
 
   if (!mModeInitialized) {
     //
@@ -1090,7 +1481,10 @@ BootManagerMenuEntry (
   //
   // Set back to conventional setup resolution
   //
-  BdsSetConsoleMode (TRUE);
+  Status = BdsSetConsoleMode (TRUE);
+  DEBUG ((DEBUG_ERROR, "BootManagerMenu: BdsSetConsoleMode=%r\n", Status));
+
+  SetFullscreenTextMode ();
 
   //
   // Initialize Boot menu data
@@ -1105,6 +1499,7 @@ BootManagerMenuEntry (
   // According to boot menu data to draw boot popup menu
   //
   DrawBootPopupMenu (&BootMenuData);
+  DEBUG ((DEBUG_ERROR, "BootManagerMenu: drawn, items=%u\n", BootMenuData.ItemCount));
 
   //
   // check user input to determine want to re-draw or boot from user selected item
@@ -1167,5 +1562,10 @@ BootManagerMenuEntry (
 
   HiiRemovePackages (gStringPackHandle);
 
+  if (mUsingGraphicsConsole && (mSavedConOut != NULL)) {
+    gST->ConOut           = mSavedConOut;
+    gST->ConsoleOutHandle = mSavedConsoleOutHandle;
+  }
+
   return Status;
 }
