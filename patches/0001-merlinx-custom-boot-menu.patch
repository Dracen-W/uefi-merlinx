+  DEBUG ((DEBUG_ERROR, "BootManagerMenu: entry\n"));
+
   //
   // Set Logo status invalid when boot manager menu is launched
   //
@@ -1018,6 +1405,7 @@ BootManagerMenuEntry (
   }
 
   gBS->SetWatchdogTimer (0x0000, 0x0000, 0x0000, NULL);
+  DEBUG ((DEBUG_ERROR, "BootManagerMenu: watchdog done\n"));
 
   gStringPackHandle = HiiAddPackages (
                         &gEfiCallerIdGuid,
@@ -1026,14 +1414,17 @@ BootManagerMenuEntry (
                         NULL
                         );
   ASSERT (gStringPackHandle != NULL);
+  DEBUG ((DEBUG_ERROR, "BootManagerMenu: hii done\n"));
 
-  //
-  // Connect all prior to entering the platform setup menu.
