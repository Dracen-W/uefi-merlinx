@@ -283,6 +656,17 @@ InitializeBootMenuScreen (
   BootMenuData->MenuScreen.StartCol = (Column -  BootMenuData->MenuScreen.Width) / 2;
   BootMenuData->MenuScreen.StartRow = (Row -  BootMenuData->MenuScreen.Height) / 2;
 
+  if (mGraphicsOutput != NULL) {
+    //
+    // The visible UEFI scanout starts roughly at the middle of the panel on
+    // this device, so nudge the popup down before it is clipped at the top.
+    //
+    BootMenuData->MenuScreen.StartRow += 8;
+    if (BootMenuData->MenuScreen.StartRow + BootMenuData->MenuScreen.Height > Row) {
+      BootMenuData->MenuScreen.StartRow = Row - BootMenuData->MenuScreen.Height;
+    }
+  }
+
   return EFI_SUCCESS;
 }
 
@@ -587,6 +971,7 @@ DrawBootPopupMenu (
   UINTN       ItemCountPerScreen;
 
