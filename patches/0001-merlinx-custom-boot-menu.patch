+/**
+  Switch ConOut to the GraphicsConsole instance, if one is available.
+
+  The platform also exposes a framebuffer-backed serial console.  ConSplitter
+  sends text to both consoles, but the framebuffer serial console ignores the
+  UEFI cursor position and ClearScreen(), so the menu ends up painted at the
+  bottom of the debug log instead of at a screen position we control.
+**/
+STATIC
+VOID
+SelectGraphicsConsole (
+  VOID
+  )
+{
+  EFI_STATUS                       Status;
+  EFI_HANDLE                       *HandleBuffer;
+  UINTN                            HandleCount;
+  UINTN                            Index;
+  EFI_GRAPHICS_OUTPUT_PROTOCOL     *GraphicsOutput;
+  EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL  *SimpleTextOut;
+
+  HandleBuffer = NULL;
+  HandleCount  = 0;
+  Status       = gBS->LocateHandleBuffer (
+                        ByProtocol,
+                        &gEfiSimpleTextOutProtocolGuid,
+                        NULL,
+                        &HandleCount,
+                        &HandleBuffer
+                        );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "BootManagerMenu: no text out handles (%r)\n", Status));
+    return;
+  }
+
+  for (Index = 0; Index < HandleCount; Index++) {
+    //
+    // gST->ConsoleOutHandle is the ConSplitter virtual handle.  PostGopSetup()
+    // installs GOP on it, but its OutputString/ClearScreen still forwards to
+    // the framebuffer serial console.  Skip it and look for the real
+    // GraphicsConsole instance that owns the GOP.
+    //
+    if (HandleBuffer[Index] == gST->ConsoleOutHandle) {
+      continue;
+    }
+
+    GraphicsOutput = NULL;
+    SimpleTextOut  = NULL;
+    Status         = gBS->HandleProtocol (
+                            HandleBuffer[Index],
+                            &gEfiGraphicsOutputProtocolGuid,
+                            (VOID **)&GraphicsOutput
+                            );
+    if (EFI_ERROR (Status) || (GraphicsOutput == NULL)) {
+      continue;
+    }
+
+    Status = gBS->HandleProtocol (
+                    HandleBuffer[Index],
+                    &gEfiSimpleTextOutProtocolGuid,
+                    (VOID **)&SimpleTextOut
+                    );
+    if (EFI_ERROR (Status) || (SimpleTextOut == NULL)) {
+      continue;
+    }
+
+    mSavedConOut          = gST->ConOut;
+    mSavedConsoleOutHandle = gST->ConsoleOutHandle;
+    mGraphicsOutput        = GraphicsOutput;
+    gST->ConOut            = SimpleTextOut;
+    gST->ConsoleOutHandle  = HandleBuffer[Index];
+    mUsingGraphicsConsole  = TRUE;
+    DEBUG ((DEBUG_ERROR, "BootManagerMenu: using GraphicsConsole\n"));
+    break;
+  }
+
+  if (!mUsingGraphicsConsole) {
+    DEBUG ((DEBUG_ERROR, "BootManagerMenu: GraphicsConsole not found\n"));
+  }
+
+  FreePool (HandleBuffer);
+}
+
+/**
+  Select the text mode that uses the largest part of the panel.
+**/
+STATIC
+VOID
+SetFullscreenTextMode (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+  UINTN       MaxMode;
+  UINTN       ModeNumber;
+  UINTN       BestMode;
+  UINTN       BestCells;
+  UINTN       Columns;
+  UINTN       Rows;
+
+  if (!mUsingGraphicsConsole) {
+    return;
+  }
+
+  MaxMode   = (UINTN)gST->ConOut->Mode->MaxMode;
+  BestMode  = (UINTN)gST->ConOut->Mode->Mode;
+  BestCells = 0;
+
+  for (ModeNumber = 0; ModeNumber < MaxMode; ModeNumber++) {
+    Columns = 0;
+    Rows    = 0;
+    Status  = gST->ConOut->QueryMode (gST->ConOut, ModeNumber, &Columns, &Rows);
+    if (EFI_ERROR (Status)) {
+      continue;
+    }
+
+    if (Columns * Rows > BestCells) {
+      BestCells = Columns * Rows;
+      BestMode  = ModeNumber;
+    }
+  }
+
+  Status = gST->ConOut->SetMode (gST->ConOut, BestMode);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "BootManagerMenu: SetMode(%u) failed: %r\n", BestMode, Status));
+    return;
+  }
+
+  Columns = 0;
+  Rows    = 0;
+  gST->ConOut->QueryMode (gST->ConOut, BestMode, &Columns, &Rows);
+  DEBUG ((DEBUG_ERROR, "BootManagerMenu: text mode=%u %ux%u\n", BestMode, Columns, Rows));
+}
+
+/**
+  Paint the whole panel opaque black directly through GOP.
+**/
+STATIC
+VOID
+ClearScreenOpaque (
+  VOID
+  )
+{
+  EFI_STATUS                     Status;
+  EFI_GRAPHICS_OUTPUT_BLT_PIXEL  Black;
+
+  if (mGraphicsOutput == NULL) {
+    return;
+  }
+
+  Black.Blue     = 0;
+  Black.Green    = 0;
+  Black.Red      = 0;
+  Black.Reserved = 0xFF;
+
+  Status = mGraphicsOutput->Blt (
+                              mGraphicsOutput,
+                              &Black,
+                              EfiBltVideoFill,
+                              0,
+                              0,
+                              0,
+                              0,
+                              mGraphicsOutput->Mode->Info->HorizontalResolution,
+                              mGraphicsOutput->Mode->Info->VerticalResolution,
+                              0
+                              );
+  DEBUG ((DEBUG_ERROR, "BootManagerMenu: opaque clear=%r\n", Status));
+}
+
