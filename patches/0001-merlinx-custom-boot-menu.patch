+STATIC
+VOID
+GopPrintAt (
+  IN UINTN         Column,
+  IN UINTN         Row,
+  IN CONST CHAR16  *String,
+  IN UINTN         Count
+  )
+{
+  UINTN                          X;
+  UINTN                          Y;
+  UINTN                          Width;
+  UINTN                          Height;
+  UINTN                          Index;
+  UINTN                          GlyphX;
+  UINTN                          GlyphY;
+  UINTN                          ScaleX;
+  UINTN                          ScaleY;
+  UINT32                         Attribute;
+  CHAR16                         Char;
+  CONST UINT8                    *Glyph;
+  EFI_GRAPHICS_OUTPUT_BLT_PIXEL  *Buffer;
+  EFI_GRAPHICS_OUTPUT_BLT_PIXEL  Foreground;
+  EFI_GRAPHICS_OUTPUT_BLT_PIXEL  Background;
+
+  if ((mGraphicsOutput == NULL) || (Count == 0)) {
+    return;
+  }
+
+  X = Column * BOOT_MENU_CELL_W;
+  Y = Row * BOOT_MENU_CELL_H;
+  if ((X >= mGraphicsOutput->Mode->Info->HorizontalResolution) ||
+      (Y + BOOT_MENU_CELL_H > mGraphicsOutput->Mode->Info->VerticalResolution))
+  {
+    return;
+  }
+
+  if (((X + Count * BOOT_MENU_CELL_W) > mGraphicsOutput->Mode->Info->HorizontalResolution)) {
+    Count = (mGraphicsOutput->Mode->Info->HorizontalResolution - X) / BOOT_MENU_CELL_W;
+  }
+
+  if (Count == 0) {
+    return;
+  }
+
+  Width  = Count * BOOT_MENU_CELL_W;
+  Height = BOOT_MENU_CELL_H;
+  Buffer = AllocateZeroPool (Width * Height * sizeof (EFI_GRAPHICS_OUTPUT_BLT_PIXEL));
+  if (Buffer == NULL) {
+    return;
+  }
+
+  Attribute  = (UINT32)gST->ConOut->Mode->Attribute;
+  Foreground = mBootMenuColors[Attribute & 0x0F];
+  Background = mBootMenuColors[(Attribute >> 4) & 0x0F];
+
+  for (Index = 0; Index < Count; Index++) {
+    Char = String[Index];
+    if ((Char < BOOT_MENU_FONT_FIRST) || (Char > BOOT_MENU_FONT_LAST)) {
+      Char = L'?';
+    }
+
+    Glyph = mBootMenuFont[Char - BOOT_MENU_FONT_FIRST];
+    for (GlyphY = 0; GlyphY < EFI_GLYPH_HEIGHT; GlyphY++) {
+      for (GlyphX = 0; GlyphX < EFI_GLYPH_WIDTH; GlyphX++) {
+        for (ScaleY = 0; ScaleY < BOOT_MENU_SCALE; ScaleY++) {
+          for (ScaleX = 0; ScaleX < BOOT_MENU_SCALE; ScaleX++) {
+            Buffer[(GlyphY * BOOT_MENU_SCALE + ScaleY) * Width +
+                   Index * BOOT_MENU_CELL_W + GlyphX * BOOT_MENU_SCALE + ScaleX] =
+              ((Glyph[GlyphY] & (0x80 >> GlyphX)) != 0) ? Foreground : Background;
+          }
+        }
+      }
+    }
+  }
+
+  mGraphicsOutput->Blt (
+                      mGraphicsOutput,
+                      Buffer,
+                      EfiBltBufferToVideo,
+                      0,
+                      0,
+                      X,
+                      Y,
+                      Width,
+                      Height,
+                      Width * sizeof (EFI_GRAPHICS_OUTPUT_BLT_PIXEL)
+                      );
+  FreePool (Buffer);
+}
+
+STATIC
+UINTN
+PrintScaledStringAt (
+  IN UINTN   Column,
+  IN UINTN   Row,
+  IN CHAR16  *String
+  )
+{
+  UINTN  ScreenWidth;
+  UINTN  ScreenRows;
+  UINTN  Length;
+
+  gST->ConOut->QueryMode (
+                 gST->ConOut,
+                 gST->ConOut->Mode->Mode,
+                 &ScreenWidth,
+                 &ScreenRows
+                 );
+  ScreenWidth /= BOOT_MENU_SCALE;
+  ScreenRows  /= BOOT_MENU_SCALE;
+
+  if ((Column >= ScreenWidth) || (Row >= ScreenRows)) {
+    return 0;
+  }
+
+  Length = StrLen (String);
+  if (Column + Length > ScreenWidth) {
+    Length = ScreenWidth - Column;
+  }
+
+  GopPrintAt (Column, Row, String, Length);
+  return Length;
+}
