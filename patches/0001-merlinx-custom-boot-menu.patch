diff --git a/MdeModulePkg/Library/FrameBufferBltLib/FrameBufferBltLib.c b/MdeModulePkg/Library/FrameBufferBltLib/FrameBufferBltLib.c
index 432577b..f8f933c 100644
--- a/MdeModulePkg/Library/FrameBufferBltLib/FrameBufferBltLib.c
+++ b/MdeModulePkg/Library/FrameBufferBltLib/FrameBufferBltLib.c
@@ -244,6 +244,16 @@ FrameBufferBltLibVideoFill (
              (((Uint32 << Configure->PixelShl[2]) >> Configure->PixelShr[2]) &
               Configure->PixelMasks.BlueMask)
              );
+
+  //
+  // Preserve the reserved/alpha byte for 32-bit framebuffers.  The generic
+  // implementation above only merges R/G/B, which turns every fill into
+  // alpha=0 and leaves the previous bootloader image visible on displays
+  // that blend the UEFI layer.
+  //
+  if (Configure->BytesPerPixel == 4) {
+    WideFill |= ((UINT32)Color->Reserved << 24) & Configure->PixelMasks.ReservedMask;
+  }
   DEBUG ((
     DEBUG_VERBOSE,
     "VideoFill: color=0x%x, wide-fill=0x%x\n",
@@ -548,6 +558,17 @@ FrameBufferBltLibBufferToVideo (
     }
 
     CopyMem (Destination, Source, WidthInBytes);
+
+    //
+    // GraphicsConsole glyph buffers carry reserved/alpha = 0.  Force the
+    // alpha byte opaque for 32-bit scanout, otherwise the console text is
+    // blended away on displays that honour the alpha channel.
+    //
+    if (Configure->BytesPerPixel == 4) {
+      for (IndexX = 0; IndexX < Width; IndexX++) {
+        Destination[IndexX * 4 + 3] = 0xFF;
+      }
+    }
   }
 
   return RETURN_SUCCESS;
