+#define BOOT_MENU_SCALE   2
+#define BOOT_MENU_CELL_W  (EFI_GLYPH_WIDTH * BOOT_MENU_SCALE)
+#define BOOT_MENU_CELL_H  (EFI_GLYPH_HEIGHT * BOOT_MENU_SCALE)
+
+STATIC CONST EFI_GRAPHICS_OUTPUT_BLT_PIXEL  mBootMenuColors[16] = {
+  { 0x00, 0x00, 0x00, 0xFF },  // BLACK
+  { 0x98, 0x00, 0x00, 0xFF },  // LIGHTBLUE
+  { 0x00, 0x98, 0x00, 0xFF },  // LIGHTGREEN
+  { 0x98, 0x98, 0x00, 0xFF },  // LIGHTCYAN
+  { 0x00, 0x00, 0x98, 0xFF },  // LIGHTRED
+  { 0x98, 0x00, 0x98, 0xFF },  // MAGENTA
+  { 0x00, 0x98, 0x98, 0xFF },  // BROWN
+  { 0x98, 0x98, 0x98, 0xFF },  // LIGHTGRAY
+  { 0x30, 0x30, 0x30, 0xFF },  // DARKGRAY
+  { 0xFF, 0x00, 0x00, 0xFF },  // BLUE
+  { 0x00, 0xFF, 0x00, 0xFF },  // LIME
+  { 0xFF, 0xFF, 0x00, 0xFF },  // CYAN
+  { 0x00, 0x00, 0xFF, 0xFF },  // RED
+  { 0xFF, 0x00, 0xFF, 0xFF },  // FUCHSIA
+  { 0x00, 0xFF, 0xFF, 0xFF },  // YELLOW
+  { 0xFF, 0xFF, 0xFF, 0xFF }   // WHITE
